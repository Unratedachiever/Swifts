# Development defaults for the PHP port of SwiftShip Logistics.
#
# These are NOT secrets — they point at the local Mailpit container. The
# platform-managed /run/base44/app.env is loaded LAST in compose, so a real
# SMTP host/user/password supplied on the Base44 dashboard always overrides
# anything here.
APP_ENV=development

# mail | smtp | log   (log writes the rendered email to data/mail/ instead)
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# "" (plain/no TLS), "tls" (STARTTLS) or "ssl" (implicit TLS)
SMTP_SECURE=
MAIL_FROM=no-reply@swiftship.test
MAIL_FROM_NAME=SwiftShip Logistics
